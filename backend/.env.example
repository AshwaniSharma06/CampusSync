# Application Environment (development | production)
APP_ENV=development

# Database Configuration (Defaults to sqlite:///campussync.db or persistent path /data/campussync.db)
DATABASE_URL=sqlite:///campussync.db

# Authentication Security (Generate a 32+ character random string in production)
SECRET_KEY=your-secure-production-secret-key-min-32-chars

# Google Gemini API for CampusSync AI RAG
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-flash-lite-latest

# Vector Database Persistence (Defaults to backend/data/chromadb or /data/chromadb)
CHROMA_PERSIST_DIRECTORY=backend/data/chromadb

# Automated 3-Hour Scraping Scheduler
SCRAPER_ENABLED=true
SCRAPER_INTERVAL_MINUTES=180

# Production Allowed Origins (Comma-separated URLs)
FRONTEND_URL=https://your-campussync-frontend.vercel.app
